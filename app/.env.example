# Copia este archivo como ".env" (sin .example) y escribe tu clave.
# El archivo .env es PRIVADO: no se sube al repositorio.

# API key de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Uno o varios modelos separados por comas. Si uno agota su cuota diaria o esta saturado, se usa el siguiente.
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.5-flash-lite
